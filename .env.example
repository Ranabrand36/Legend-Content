# Supabase PostgreSQL Transaction Pooler connection string (keep secret)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Dashboard authentication (set a long unique password)
WEB_USERNAME=owner
WEB_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD

# Optional
BOT_PUBLIC_URL=https://your-dashboard.vercel.app
SUPPORT_USERNAME=@your_support_username
