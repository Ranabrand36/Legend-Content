# Telegram bot token from @BotFather
BOT_TOKEN=PASTE_BOT_TOKEN_HERE

# Your numeric Telegram user ID. This is the only owner/admin.
OWNER_ID=123456789

# Web dashboard basic authentication
WEB_USERNAME=owner
WEB_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD

# Web server configuration
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Optional: public HTTPS dashboard URL shown inside Telegram admin panel
BOT_PUBLIC_URL=

# Optional defaults
SUPPORT_USERNAME=@your_support_username
WELCOME_TEXT=Welcome to <b>Legend Content Hub</b>! Choose an option below.

# Optional database path
DB_PATH=data/legend_content_hub.sqlite3
